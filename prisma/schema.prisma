// =====================================================================
// Site da igreja — schema Prisma (Postgres)
// Prisma ORM 7: a URL do banco fica em prisma7.config.ts, não aqui.
// Usuários e login ficam no Clerk; aqui guardamos só o papel de cada
// pessoa da equipe (StaffMember), ligado pelo clerkUserId.
// =====================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum Role {
  ADMIN
  MIDIA
  LIDER

  @@map("role")
}

enum ContentStatus {
  DRAFT
  PENDING
  PUBLISHED

  @@map("content_status")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  SUBMIT // líder envia para aprovação
  APPROVE
  REJECT // mídia devolve com comentário
  UPLOAD
  ROLE_GRANT
  ROLE_REVOKE
  SETTINGS_CHANGE
  EXPORT // baixou planilha com dado pessoal (inscritos)
  VIEW_SENSITIVE // abriu um dado sensível (ex.: resposta de antecedentes de um voluntário)

  @@map("audit_action")
}

enum AuditEntity {
  EVENT
  ANNOUNCEMENT
  ALBUM
  PHOTO
  MINISTRY
  SERVICE
  SITE_SETTINGS
  STAFF_MEMBER
  FAQ
  REGISTRATION
  LIVE_STREAM
  GIVING_PROJECT
  VOLUNTEER
  MINISTRY_FUNCTION
  ROSTER_PERIOD

  @@map("audit_entity")
}

enum MaritalStatus {
  SINGLE // solteiro(a)
  MARRIED // casado(a)
  STABLE_UNION // união estável / amasiado(a)
  DIVORCED // divorciado(a) / separado(a)
  WIDOWED // viúvo(a)

  @@map("marital_status")
}

// Como o evento recebe inscrições (FA-28).
enum RegistrationMode {
  NONE // sem inscrição
  EXTERNAL // link de fora (Google Forms etc.) em Event.registrationUrl
  INTERNAL // formulário do próprio site, salvo em EventRegistration

  @@map("registration_mode")
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED

  @@map("registration_status")
}

// ---------------------------------------------------------------------
// Equipe (espelho do usuário do Clerk)
// Login, senha e e-mail ficam no Clerk. Aqui ficam os papéis e o vínculo
// com o conteúdo e a auditoria. Criado pelo webhook user.created do Clerk
// (ou no primeiro acesso ao painel); desativado no user.deleted.
// ---------------------------------------------------------------------

model StaffMember {
  id          String    @id @default(uuid()) @db.Uuid
  clerkUserId String    @unique @map("clerk_user_id")
  name        String
  email       String    @unique
  imageUrl    String?   @map("image_url")
  active      Boolean   @default(true) // false = sem acesso, histórico preservado
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles        StaffRole[] @relation("RoleOwner")
  rolesGranted StaffRole[] @relation("RoleGrantedBy")
  auditLogs    AuditLog[]

  events               Event[]             @relation("EventCreatedBy")
  eventsUpdated        Event[]             @relation("EventUpdatedBy")
  announcements        Announcement[]      @relation("AnnouncementCreatedBy")
  announcementsUpdated Announcement[]      @relation("AnnouncementUpdatedBy")
  albums               Album[]             @relation("AlbumCreatedBy")
  settingsUpdates      SiteSettings[]      @relation("SettingsUpdatedBy")
  rosterPeriods        RosterPeriod[]      @relation("RosterPeriodCreatedBy")
  rosterPublications   RosterPublication[]

  @@map("staff_members")
}

// Papéis de cada pessoa. Uma pessoa pode ter vários:
// ex.: MIDIA (geral) + LIDER do ministério Jovens + LIDER do Kids.
// ministryId só é usado com LIDER; ADMIN e MIDIA ficam com ministryId nulo.
model StaffRole {
  id            String       @id @default(uuid()) @db.Uuid
  role          Role
  staffMemberId String       @map("staff_member_id") @db.Uuid
  staffMember   StaffMember  @relation("RoleOwner", fields: [staffMemberId], references: [id], onDelete: Cascade)
  ministryId    String?      @map("ministry_id") @db.Uuid
  ministry      Ministry?    @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  grantedById   String?      @map("granted_by_id") @db.Uuid
  grantedBy     StaffMember? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([staffMemberId, role, ministryId])
  @@index([ministryId])
  @@map("staff_roles")
}

// Auditoria: uma linha por ação no painel. Nunca é editada nem apagada.
// actorName/entityLabel são cópias do momento da ação, para o histórico
// continuar legível mesmo se a pessoa ou o item forem removidos.
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  action      AuditAction
  entityType  AuditEntity @map("entity_type")
  entityId    String      @map("entity_id") // id do item afetado (texto: aceita uuid ou "1" do SiteSettings)
  entityLabel String?     @map("entity_label") // ex.: título do evento no momento da ação
  changes     Json? // { campo: { from, to } } no UPDATE; snapshot no CREATE/DELETE
  note        String? // ex.: comentário da devolução

  actorId      String?      @map("actor_id") @db.Uuid
  actor        StaffMember? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorClerkId String       @map("actor_clerk_id")
  actorName    String       @map("actor_name")
  actorRoles   String?      @map("actor_roles") // papéis no momento da ação, ex.: "Mídia · Líder (Kids)"

  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------
// Conteúdo institucional
// ---------------------------------------------------------------------

// Categorias de eventos/avisos, cadastradas pela equipe (não é texto livre).
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  events        Event[]
  announcements Announcement[]

  @@map("categories")
}

model Ministry {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  schedule    String? // ex.: "Sábados, 19h"
  whatsapp    String? // ex.: "5527999999999", pro botão wa.me do líder
  coverPath   String?  @map("cover_path")
  icon        String? // chave de src/lib/ministry-icons.ts; null = automático pelo nome
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Ministério e departamento de voluntariado são o mesmo cadastro (Kids é os
  // dois; Limpeza só tem escala; Casais só tem página).
  showOnSite       Boolean @default(true) @map("show_on_site") // aparece em /ministerios e na Home
  hasRoster        Boolean @default(false) @map("has_roster") // tem equipe de voluntários / escala
  // Quantas pessoas por culto quando o ministério não tem funções (sugestão de escala).
  rosterPerService Int     @default(0) @map("roster_per_service") // meta opcional por culto (0 = sem meta)

  leaders            StaffRole[]
  events             Event[]
  announcements      Announcement[]
  functions          MinistryFunction[]
  memberships        VolunteerMembership[]
  assignments        RosterAssignment[]
  rosterSkips        RosterSlotSkip[]
  rosterPublications RosterPublication[]

  @@map("ministries")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  name        String // ex.: "Culto da Família"
  weekday     Int      @db.SmallInt // 0 = domingo ... 6 = sábado
  startsAt    DateTime @map("starts_at") @db.Time(0)
  description String? // aparece na Agenda, em "Toda semana"
  sortOrder   Int      @default(0) @map("sort_order")

  rosterSlots RosterSlot[]

  @@map("services")
}

// ---------------------------------------------------------------------
// Agenda e avisos
// ---------------------------------------------------------------------

model Event {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  slug            String        @unique
  description     String?
  coverPath       String?       @map("cover_path")
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(6)
  location        String?
  registrationUrl String?       @map("registration_url")
  isFeatured      Boolean       @default(false) @map("is_featured")
  status          ContentStatus @default(DRAFT)
  reviewNote      String?       @map("review_note") // motivo da devolução pela mídia
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)

  // Inscrições (FA-28). Vagas contam pessoas (soma de partySize); null = sem limite.
  registrationMode     RegistrationMode    @default(NONE) @map("registration_mode")
  capacity             Int?
  registrationClosesAt DateTime?           @map("registration_closes_at") @db.Timestamptz(6) // null = até o início
  askPartySize         Boolean             @default(false) @map("ask_party_size")
  askFirstTime         Boolean             @default(false) @map("ask_first_time")
  registrations        EventRegistration[]

  categoryId  String?      @map("category_id") @db.Uuid
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ministryId  String?      @map("ministry_id") @db.Uuid
  ministry    Ministry?    @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   StaffMember? @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   StaffMember? @relation("EventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  albums      Album[]
  rosterSlots RosterSlot[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, startsAt])
  @@map("events")
}

model Announcement {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  body        String?
  imagePath   String?       @map("image_path")
  publishAt   DateTime      @default(now()) @map("publish_at") @db.Timestamptz(6)
  unpublishAt DateTime?     @map("unpublish_at") @db.Timestamptz(6)
  status      ContentStatus @default(DRAFT)
  reviewNote  String?       @map("review_note")

  categoryId  String?      @map("category_id") @db.Uuid
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ministryId  String?      @map("ministry_id") @db.Uuid
  ministry    Ministry?    @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   StaffMember? @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   StaffMember? @relation("AnnouncementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, publishAt])
  @@map("announcements")
}

// ---------------------------------------------------------------------
// Galeria
// ---------------------------------------------------------------------

// Álbuns não guardam foto nenhuma — a mídia sobe as fotos numa pasta do Google
// Drive (compartilhada como "qualquer pessoa com o link pode ver") e só cola o
// link aqui. O site incorpora essa pasta (ver src/lib/google-drive.ts). Existia
// um upload direto pro Blob antes (modelo Photo, removido) — trocado porque a
// mídia já teria que subir a mesma foto duas vezes (Drive do time + aqui).
// coverPath continua sendo upload direto pro Blob (igual Event/Announcement) —
// é só a capa exibida na listagem, não as fotos do álbum.
model Album {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  slug      String    @unique
  takenOn   DateTime? @map("taken_on") @db.Date
  driveUrl  String?   @map("drive_url")
  coverPath String?   @map("cover_path")

  eventId     String?      @map("event_id") @db.Uuid
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   StaffMember? @relation("AlbumCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("albums")
}

// Inscrição feita pelo visitante no formulário do site (FA-29). Dado pessoal:
// só mídia/admin e o líder do ministério do evento veem, e é apagado 90 dias
// depois do fim do evento (src/lib/registrations.ts, LGPD).
model EventRegistration {
  id          String             @id @default(uuid()) @db.Uuid
  eventId     String             @map("event_id") @db.Uuid
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  phone       String // só dígitos, com DDI: "5527999990000"
  partySize   Int                @default(1) @map("party_size")
  firstTime   Boolean?           @map("first_time")
  status      RegistrationStatus @default(CONFIRMED)
  source      String             @default("site") // "site" | "qr"
  checkedInAt DateTime?          @map("checked_in_at") @db.Timestamptz(6)
  seenAt      DateTime?          @map("seen_at") @db.Timestamptz(6) // equipe já viu (contador de novos)
  consentAt   DateTime           @map("consent_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([eventId, phone])
  @@index([eventId, createdAt])
  @@index([seenAt])
  @@map("event_registrations")
}

// ---------------------------------------------------------------------
// Tira-dúvidas do site (bot sem IA)
// Cultos, agenda, endereço, contato, Pix e ministérios o bot já responde
// sozinho com os dados acima. Aqui ficam só as outras perguntas, com resposta
// pronta escrita pela equipe. O bot casa a pergunta do visitante pelas
// palavras-chave (sem acento/maiúscula) — ver src/lib/assistant/engine.ts.
// ---------------------------------------------------------------------

model FaqEntry {
  id           String   @id @default(uuid()) @db.Uuid
  question     String // ex.: "O que é o GFC?" — também vira botão se isFeatured
  answer       String
  keywords     String[] // ex.: ["gfc", "grupo familiar", "celula"]
  showWhatsapp Boolean  @default(false) @map("show_whatsapp") // botão do WhatsApp da igreja na resposta
  linkLabel    String?  @map("link_label")
  linkUrl      String?  @map("link_url") // "/agenda" ou "https://..."
  isFeatured   Boolean  @default(false) @map("is_featured") // aparece em "Perguntas frequentes"
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("faq_entries")
}

// ---------------------------------------------------------------------
// Tema e dados da igreja (uma linha só, id = 1)
// ---------------------------------------------------------------------

model SiteSettings {
  id          Int     @id @default(1)
  accentColor String  @default("#FFC53D") @map("accent_color")
  address     String?
  mapsUrl     String? @map("maps_url")
  whatsapp    String?
  pixKey      String? @map("pix_key")
  instagram   String?
  youtube     String? // canal (a live de cada culto fica em LiveStream)
  spotify     String? // perfil/podcast da igreja no Spotify

  // E-mails de contato (rodapé, Contribua e tira-dúvidas)
  secretaryEmail String? @map("secretary_email")
  financeEmail   String? @map("finance_email")
  adminEmail     String? @map("admin_email")

  // Fotos da Home (Aparência). null = foto padrão (src/lib/site-config.ts).
  heroImagePath  String? @map("hero_image_path")
  aboutImagePath String? @map("about_image_path")

  // Segunda camada de acesso ao /backstage, além do login do Clerk (ver
  // src/lib/panel-gate.ts). Só o hash fica salvo — o token em texto puro é
  // mostrado uma única vez, no momento em que o admin gera um novo.
  panelAccessTokenHash  String?   @map("panel_access_token_hash")
  panelAccessTokenSetAt DateTime? @map("panel_access_token_set_at") @db.Timestamptz(6)

  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   StaffMember? @relation("SettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

// Transmissão de um culto (FA-19/FA-20), cadastrada no menu Live do painel.
// Link colado à mão (sem API do YouTube). A Home mostra uma só, escolhida por
// src/lib/live-rules.ts: a que está ao vivo / começa em breve, senão a última.
model LiveStream {
  id          String   @id @default(uuid()) @db.Uuid
  title       String // ex.: "Culto da Família — domingo à noite"
  startsAt    DateTime @map("starts_at") @db.Timestamptz(6)
  youtubeUrl  String?  @map("youtube_url")
  spotifyUrl  String?  @map("spotify_url")
  description String? // tema, pregador…
  visible     Boolean  @default(true) // false = fica só no painel
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startsAt])
  @@map("live_streams")
}

// Projetos da igreja mostrados no carrossel da seção Contribua (dízimos e
// ofertas): cada slide é uma foto com título e uma frase. Cadastrados no menu
// "Projetos" do painel; sortOrder define a ordem (botões Subir/Descer).
model GivingProject {
  id          String   @id @default(uuid()) @db.Uuid
  title       String // ex.: "Espaço Gerações"
  description String? // uma ou duas frases sobre o projeto
  imagePath   String   @map("image_path") // Vercel Blob ou /projetos/... (public/)
  visible     Boolean  @default(true) // false = fica só no painel
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sortOrder])
  @@map("giving_projects")
}

// ---------------------------------------------------------------------
// Voluntários e equipes (Escala dos Ministérios, parte 1)
// Voluntário NÃO é usuário do painel: é uma pessoa numa lista, reconhecida
// pelo WhatsApp. Pode estar em vários ministérios e, em cada um, ter várias
// funções (ex.: Kids → Professor(a) e Segurança).
// ---------------------------------------------------------------------

enum VolunteerAvailability {
  WEEK_AND_WEEKEND // "Semana e fins de semana"
  WEEKEND_ONLY // "Apenas fins de semana"
  WEEKDAYS_ONLY // "Apenas durante a semana"

  @@map("volunteer_availability")
}

enum SundayShift {
  MORNING
  NIGHT
  BOTH

  @@map("sunday_shift")
}

enum MembershipStatus {
  ACTIVE // está na equipe
  INTERESTED // marcou na inscrição; o líder ainda não colocou na equipe

  @@map("membership_status")
}

model Volunteer {
  id           String                 @id @default(uuid()) @db.Uuid
  name         String
  phone        String?                @unique // só dígitos, com 55 (ex.: 5527999990000)
  availability VolunteerAvailability?
  sundayShift  SundayShift?           @map("sunday_shift")
  termSigned   Boolean?               @map("term_signed") // termo de responsabilidade do voluntariado

  // SENSÍVEL: resposta sobre antecedentes criminais do formulário de inscrição.
  // Fica fora de toda consulta (omit global em src/lib/prisma.ts); só o admin
  // vê, no "olhinho", e cada visualização vai pra Auditoria.
  backgroundCheckAnswer String? @map("background_check_answer")

  // Mais detalhes (da planilha / inscrição). Só aparecem em "Editar", pra quem
  // cuida do ministério da pessoa. Ano de nascimento é opcional (muita gente não
  // informa); dia e mês bastam pro aniversário.
  birthDay      Int?           @map("birth_day")
  birthMonth    Int?           @map("birth_month")
  birthYear     Int?           @map("birth_year")
  maritalStatus MaritalStatus? @map("marital_status")
  city          String?
  baptized      Boolean?
  convertedYear Int?           @map("converted_year") // ano (aproximado) da conversão

  notes     String?
  active    Boolean  @default(true)
  source    String? // de onde veio: "planilha-voluntariado", "painel"…
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships           VolunteerMembership[]
  availabilityResponses AvailabilityResponse[]
  rosterAssignments     RosterAssignment[]

  @@index([name])
  @@index([birthMonth])
  @@map("volunteers")
}

model MinistryFunction {
  id         String   @id @default(uuid()) @db.Uuid
  ministryId String   @map("ministry_id") @db.Uuid
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  name       String // ex.: "Professor(a)", "Som", "Ofertório"
  sortOrder  Int      @default(0) @map("sort_order")
  perService Int      @default(0) @map("per_service") // meta opcional por culto (0 = sem meta)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  members     VolunteerMembershipFunction[]
  assignments RosterAssignment[]

  @@unique([ministryId, name])
  @@map("ministry_functions")
}

model VolunteerMembership {
  id          String           @id @default(uuid()) @db.Uuid
  volunteerId String           @map("volunteer_id") @db.Uuid
  volunteer   Volunteer        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  ministryId  String           @map("ministry_id") @db.Uuid
  ministry    Ministry         @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  functions VolunteerMembershipFunction[]

  @@unique([volunteerId, ministryId])
  @@index([ministryId, status])
  @@map("volunteer_memberships")
}

model VolunteerMembershipFunction {
  membershipId String              @map("membership_id") @db.Uuid
  membership   VolunteerMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  functionId   String              @map("function_id") @db.Uuid
  function     MinistryFunction    @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@id([membershipId, functionId])
  @@map("volunteer_membership_functions")
}

// ---------------------------------------------------------------------
// Escala dos Ministérios, parte 2: disponibilidade do mês
// ---------------------------------------------------------------------

// Um mês de escala. O link público é /escala/<month> (ex.: /escala/2026-12):
// a pessoa digita o WhatsApp, vê os cultos do mês e marca quando pode servir.
model RosterPeriod {
  id          String       @id @default(uuid()) @db.Uuid
  month       String       @unique // "2026-12"
  closesAt    DateTime     @map("closes_at") @db.Timestamptz(6) // prazo pra responder
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   StaffMember? @relation("RosterPeriodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  slots        RosterSlot[]
  responses    AvailabilityResponse[]
  publications RosterPublication[]

  @@map("roster_periods")
}

// Cada culto do mês (gerado a partir de Cultos quando o mês é aberto).
// label é cópia do nome do culto, pra não mudar se o culto for editado depois.
model RosterSlot {
  id        String       @id @default(uuid()) @db.Uuid
  periodId  String       @map("period_id") @db.Uuid
  period    RosterPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  serviceId String?      @map("service_id") @db.Uuid
  service   Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  // Evento do mês (Agenda) que também tem escala: Culto de Jovens, Café com Pastor…
  eventId   String?      @map("event_id") @db.Uuid
  event     Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  label     String // ex.: "Culto da Família"
  startsAt  DateTime     @map("starts_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6) // quando entrou na lista do mês

  available   AvailabilityResponseSlot[]
  assignments RosterAssignment[]
  skips       RosterSlotSkip[]

  @@unique([periodId, startsAt])
  @@index([eventId])
  @@map("roster_slots")
}

// Resposta de uma pessoa pra um mês (responder de novo substitui a anterior).
// Quem não responde até o prazo entra como disponível em qualquer data.
model AvailabilityResponse {
  id          String       @id @default(uuid()) @db.Uuid
  periodId    String       @map("period_id") @db.Uuid
  period      RosterPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  volunteerId String       @map("volunteer_id") @db.Uuid
  volunteer   Volunteer    @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  note        String? // recado pro líder (opcional)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  slots AvailabilityResponseSlot[]

  @@unique([periodId, volunteerId])
  @@map("availability_responses")
}

// Os cultos que a pessoa marcou como "posso servir".
model AvailabilityResponseSlot {
  responseId String               @map("response_id") @db.Uuid
  response   AvailabilityResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  slotId     String               @map("slot_id") @db.Uuid
  slot       RosterSlot           @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([responseId, slotId])
  @@map("availability_response_slots")
}

// Escala montada (parte 3): quem serve em cada culto, por ministério. Por
// enquanto é rascunho visto só no painel (prévia).
model RosterAssignment {
  id            String            @id @default(uuid()) @db.Uuid
  slotId        String            @map("slot_id") @db.Uuid
  slot          RosterSlot        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  ministryId    String            @map("ministry_id") @db.Uuid
  ministry      Ministry          @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  volunteerId   String            @map("volunteer_id") @db.Uuid
  volunteer     Volunteer         @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  functionId    String?           @map("function_id") @db.Uuid
  function      MinistryFunction? @relation(fields: [functionId], references: [id], onDelete: SetNull)
  // Função digitada na hora ("Stories", "Recepção da porta"…). Quando bate com
  // uma função do ministério, fica só o functionId (renomear a função propaga).
  functionLabel String?           @map("function_label")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([slotId, ministryId, volunteerId])
  @@index([ministryId])
  @@index([volunteerId])
  @@map("roster_assignments")
}

/// Ministério que NÃO serve num culto/evento do mês (ex.: Kids no Café com Pastor).
/// Sem linha aqui = o ministério serve (padrão).
model RosterSlotSkip {
  slotId     String     @map("slot_id") @db.Uuid
  slot       RosterSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  ministryId String     @map("ministry_id") @db.Uuid
  ministry   Ministry   @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([slotId, ministryId])
  @@index([ministryId])
  @@map("roster_slot_skips")
}

/// Escala do ministério no mês publicada: a equipe vê as próprias datas no link
/// do mês (/escala/AAAA-MM). Sem linha = ainda é rascunho. Mudanças depois de
/// publicar aparecem na hora.
model RosterPublication {
  periodId      String       @map("period_id") @db.Uuid
  period        RosterPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  ministryId    String       @map("ministry_id") @db.Uuid
  ministry      Ministry     @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  publishedAt   DateTime     @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedById String?      @map("published_by_id") @db.Uuid
  publishedBy   StaffMember? @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@id([periodId, ministryId])
  @@index([ministryId])
  @@map("roster_publications")
}
